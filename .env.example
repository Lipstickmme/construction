# Local development only — `vercel env pull .env.local` is the easier route.
# In production these live in Vercel → Settings → Environment Variables.

# Browser (build time). Safe to expose: the anon key only grants what row
# level security allows.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Server only (api/submit-form.ts). NEVER give these a VITE_ prefix — the
# service role key bypasses every row level security policy.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
RESEND_API_KEY=re_your_key
FORM_TO=Contact@axisconstructionltd.com
FORM_FROM=Axis Website <website@axisconstructionltd.com>
