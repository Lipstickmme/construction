# Local development only — `vercel env pull .env.local` is the easier route.
# In production these live in Vercel → Settings → Environment Variables.

# Browser (build time). Safe to expose: the anon key only grants what row
# level security allows.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Server only (api/submit-form.ts). NEVER give these a VITE_ prefix — the
# service role key bypasses every row level security policy.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
RESEND_API_KEY=re_your_key
FORM_TO=Contact@axisconstructionltds.com
FORM_FROM=Axis Website <website@axisconstructionltds.com>

# Inbound mail (optional — see EMAIL.md). MAILBOX_ADDRESS is what dashboard
# replies are sent as. RESEND_WEBHOOK_SECRET is the signing secret Resend
# shows when you create the webhook. FORWARD_TO gets a copy of everything.
MAILBOX_ADDRESS=Axis Construction <Contact@axisconstructionltds.com>
RESEND_WEBHOOK_SECRET=whsec_...
FORWARD_TO=your-personal-inbox@gmail.com
