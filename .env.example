# Copy to `.env` and fill in from Supabase → Project Settings → API.
# Both values are safe in the browser: the anon key only grants what row level
# security allows. The service role key must NEVER appear here or in any
# VITE_ variable — it lives in the edge function's secrets only.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
